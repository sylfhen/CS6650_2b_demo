{
  "uid": "product-api-red",
  "title": "Product API: RED signals",
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate: requests per second by route",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[30s])) or on() label_replace(vector(0), \"route\", \"no traffic\", \"\", \"\")",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors: % of requests that were not 2xx, by status code",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (status) (rate(http_request_errors_total[30s])) / scalar(sum(rate(http_requests_total[30s])))",
          "legendFormat": "status {{status}}"
        },
        {
          "refId": "B",
          "expr": "(100 * sum(rate(http_request_errors_total[30s])) / sum(rate(http_requests_total[30s]))) or vector(0)",
          "legendFormat": "all non-2xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration: server-side latency p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[30s])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[30s])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[30s])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
